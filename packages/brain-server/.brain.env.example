# Server config for `manfred brain up`. All optional — these are the defaults.
#
# manfred loads the first of these that exists (env vars always win over a file):
#   $BRAIN_ENV_FILE  →  ~/.brain/env  →  this package's .brain.env (editable dev)
# For an installed tool (`uv tool install`), copy this to ~/.brain/env.
# For editable/dev work in the repo, copy it to .brain.env here (gitignored).

# Source-of-truth Obsidian vault (auto-created from vault-template if missing).
BRAIN_VAULT="$HOME/brain-vault"

# Derived SQLite index (rebuildable). Defaults to <vault>/.brain/index.db.
# BRAIN_DB="$HOME/brain-vault/.brain/index.db"

# Bearer token. Leave unset for local dev (auth disabled, loopback only).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BRAIN_TOKEN="replace-with-a-real-token"

# Bind address — loopback for dev, tailnet IP to share on the tailnet.
# NEVER set this to 0.0.0.0.
BRAIN_HOST="127.0.0.1"
BRAIN_PORT="8765"

#!/usr/bin/env python3
"""brain — the only client for the Obsidian Brain server.

Pure stdlib (urllib/json/argparse) for fast startup; it must NOT import the
server package. Resolves the host/token from (in order):

    1. BRAIN_URL / BRAIN_TOKEN environment variables
    2. plugins/brain/brain.local.json  (gitignored, next to this plugin)
    3. ~/.brain/config.json
    4. default http://localhost:8765 (no token)

Writes are resilient: when the server is unreachable, the request is appended to
~/.brain/outbox.ndjson and replayed on the next successful write or `brain flush`.
Reads degrade gracefully (recall returns no hits) so a hook never blocks a turn.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

DEFAULT_URL = "http://localhost:8765"
OUTBOX = Path.home() / ".brain" / "outbox.ndjson"
PLUGIN_LOCAL = Path(__file__).resolve().parent.parent / "brain.local.json"
HOME_CONFIG = Path.home() / ".brain" / "config.json"


def resolve_config() -> tuple[str, str]:
    url = os.environ.get("BRAIN_URL")
    token = os.environ.get("BRAIN_TOKEN")
    if url:
        return url.rstrip("/"), token or ""
    for cfg_path in (PLUGIN_LOCAL, HOME_CONFIG):
        if cfg_path.exists():
            try:
                data = json.loads(cfg_path.read_text())
            except (json.JSONDecodeError, OSError):
                continue
            return data.get("url", DEFAULT_URL).rstrip("/"), token or data.get("token", "")
    return DEFAULT_URL, token or ""


class Offline(Exception):
    pass


def _request(method: str, url: str, token: str, payload=None, timeout=5):
    data = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode()
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="replace")
        raise SystemExit(f"brain: HTTP {e.code}: {detail}")
    except (urllib.error.URLError, TimeoutError, ConnectionError, OSError):
        raise Offline()


# ---- outbox ---------------------------------------------------------------


def _enqueue(route: str, payload: dict, ts: str = "") -> None:
    OUTBOX.parent.mkdir(parents=True, exist_ok=True)
    with OUTBOX.open("a") as f:
        f.write(json.dumps({"route": route, "payload": payload}) + "\n")


def _drain_outbox(base: str, token: str) -> int:
    if not OUTBOX.exists():
        return 0
    lines = [ln for ln in OUTBOX.read_text().splitlines() if ln.strip()]
    sent = 0
    remaining: list[str] = []
    for i, ln in enumerate(lines):
        if remaining:  # a prior item failed; keep the rest queued in order
            remaining.append(ln)
            continue
        try:
            item = json.loads(ln)
            _request("POST", base + item["route"], token, item["payload"])
            sent += 1
        except Offline:
            remaining.append(ln)
        except (json.JSONDecodeError, KeyError):
            continue  # drop malformed lines
    if remaining:
        OUTBOX.write_text("\n".join(remaining) + "\n")
    else:
        OUTBOX.unlink(missing_ok=True)
    return sent


def _post_resilient(base: str, token: str, route: str, payload: dict) -> dict:
    """POST, draining the outbox first; queue locally if offline."""
    try:
        _drain_outbox(base, token)
        return _request("POST", base + route, token, payload)
    except Offline:
        _enqueue(route, payload)
        print(f"brain: offline — queued {route} to {OUTBOX}", file=sys.stderr)
        return {"queued": True}


# ---- output helpers -------------------------------------------------------


def _emit(obj, as_json: bool, human):
    if as_json:
        print(json.dumps(obj))
    else:
        human(obj)


# ---- command handlers -----------------------------------------------------


def cmd_recall(args, base, token):
    params = {"q": args.query, "k": args.k}
    if args.type:
        params["type"] = args.type
    if args.tier:
        params["tier"] = args.tier
    url = base + "/recall?" + urllib.parse.urlencode(params)
    try:
        res = _request("GET", url, token)
    except Offline:
        res = {"hits": []}
        if not args.json:
            print("brain: offline — no recall", file=sys.stderr)

    def human(r):
        hits = r.get("hits", [])
        if not hits:
            print("(no hits)")
            return
        for h in hits:
            print(f"[{h['type']}/{h['tier']}] {h['title']}  ({h['id']})")
            if h.get("snippet"):
                print(f"    {h['snippet']}")

    _emit(res, args.json, human)


def cmd_get(args, base, token):
    try:
        res = _request("GET", f"{base}/notes/{args.id}", token)
    except Offline:
        raise SystemExit("brain: offline")

    def human(n):
        fm = n["frontmatter"]
        print(f"# {fm['title']}  ({fm['id']})")
        print(f"type={fm['type']} tier={fm['tier']} accessed={fm.get('access_count')}")
        print()
        print(n["body"])

    _emit(res, args.json, human)


def cmd_neighbors(args, base, token):
    try:
        res = _request("GET", f"{base}/notes/{args.id}/neighbors?depth={args.depth}", token)
    except Offline:
        raise SystemExit("brain: offline")

    def human(r):
        for node in r.get("nodes", []):
            print(f"- {node['title']} ({node['id']})")
        for e in r.get("edges", []):
            print(f"  {e['src']} -[{e['rel']}]-> {e['dst']}")

    _emit(res, args.json, human)


def cmd_write(args, base, token):
    if args.body_file == "-":
        body = sys.stdin.read()
    elif args.body_file:
        body = Path(args.body_file).read_text()
    else:
        body = args.body or ""
    payload = {
        "title": args.title,
        "type": args.type,
        "body": body,
        "tier": args.tier,
    }
    if args.links:
        payload["links"] = [s for s in args.links.split(",") if s]
    if args.tags:
        payload["tags"] = [s for s in args.tags.split(",") if s]
    if args.confidence is not None:
        payload["confidence"] = args.confidence
    if args.source_session:
        payload["source_session"] = args.source_session
    if args.created_by:
        payload["created_by"] = args.created_by
    res = _post_resilient(base, token, "/notes", payload)
    _emit(res, args.json, lambda r: print(r["id"] if "id" in r else "queued (offline)"))


def cmd_link(args, base, token):
    res = _post_resilient(base, token, "/links",
                          {"src": args.src, "dst": args.dst, "rel": args.rel})
    _emit(res, args.json, lambda r: print("ok" if r.get("ok") or r.get("queued") else r))


def cmd_review_queue(args, base, token):
    try:
        res = _request("GET", f"{base}/review/queue?since={args.since}", token)
    except Offline:
        res = {"items": []}

    def human(r):
        for it in r.get("items", []):
            print(f"[{it['type']}] {it['title']}  ({it['id']})  conf={it.get('confidence')}")

    _emit(res, args.json, human)


def cmd_promote(args, base, token):
    res = _post_resilient(base, token, "/review/promote", {"id": args.id})
    _emit(res, args.json, lambda r: print("ok" if r.get("ok") or r.get("queued") else r))


def cmd_merge(args, base, token):
    res = _post_resilient(base, token, "/review/merge", {"ids": args.ids, "into": args.into})
    _emit(res, args.json, lambda r: print("ok" if r.get("ok") or r.get("queued") else r))


def cmd_discard(args, base, token):
    res = _post_resilient(base, token, "/review/discard", {"id": args.id})
    _emit(res, args.json, lambda r: print("ok" if r.get("ok") or r.get("queued") else r))


def cmd_stats(args, base, token):
    try:
        res = _request("GET", f"{base}/stats", token)
    except Offline:
        raise SystemExit("brain: offline")
    _emit(res, args.json, lambda r: print(json.dumps(r, indent=2)))


def cmd_health(args, base, token):
    try:
        res = _request("GET", f"{base}/healthz", token)
    except Offline:
        raise SystemExit("brain: unreachable")
    _emit(res, args.json, lambda r: print(f"ok notes={r.get('notes')} version={r.get('version')}"))


def cmd_rebuild(args, base, token):
    try:
        res = _request("POST", base + "/admin/rebuild", token)
    except Offline:
        raise SystemExit("brain: offline")
    _emit(res, args.json, lambda r: print(f"rebuilt index: {r.get('notes')} notes"))


def cmd_flush(args, base, token):
    try:
        sent = _drain_outbox(base, token)
    except Offline:
        raise SystemExit("brain: still offline")
    print(f"flushed {sent} queued write(s)")


# ---- parser ---------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="brain", description="Obsidian Brain client")
    sub = p.add_subparsers(dest="cmd", required=True)

    def add_json(sp):
        sp.add_argument("--json", action="store_true", help="emit raw API JSON")

    r = sub.add_parser("recall")
    r.add_argument("query")
    r.add_argument("--type")
    r.add_argument("--tier")
    r.add_argument("--k", type=int, default=8)
    add_json(r)
    r.set_defaults(func=cmd_recall)

    g = sub.add_parser("get")
    g.add_argument("id")
    add_json(g)
    g.set_defaults(func=cmd_get)

    n = sub.add_parser("neighbors")
    n.add_argument("id")
    n.add_argument("--depth", type=int, default=1)
    add_json(n)
    n.set_defaults(func=cmd_neighbors)

    w = sub.add_parser("write")
    w.add_argument("--title", required=True)
    w.add_argument("--type", required=True)
    w.add_argument("--body")
    w.add_argument("--body-file", help="path, or - for stdin")
    w.add_argument("--tags")
    w.add_argument("--links")
    w.add_argument("--tier", default="inbox")
    w.add_argument("--confidence", type=float)
    w.add_argument("--source-session")
    w.add_argument("--created-by")
    add_json(w)
    w.set_defaults(func=cmd_write)

    lk = sub.add_parser("link")
    lk.add_argument("src")
    lk.add_argument("dst")
    lk.add_argument("--rel", default="relates_to")
    add_json(lk)
    lk.set_defaults(func=cmd_link)

    rq = sub.add_parser("review-queue")
    rq.add_argument("--since", default="7d")
    add_json(rq)
    rq.set_defaults(func=cmd_review_queue)

    pr = sub.add_parser("promote")
    pr.add_argument("id")
    add_json(pr)
    pr.set_defaults(func=cmd_promote)

    mg = sub.add_parser("merge")
    mg.add_argument("ids", nargs="+")
    mg.add_argument("--into", required=True)
    add_json(mg)
    mg.set_defaults(func=cmd_merge)

    dc = sub.add_parser("discard")
    dc.add_argument("id")
    add_json(dc)
    dc.set_defaults(func=cmd_discard)

    st = sub.add_parser("stats")
    add_json(st)
    st.set_defaults(func=cmd_stats)

    h = sub.add_parser("health")
    add_json(h)
    h.set_defaults(func=cmd_health)

    rb = sub.add_parser("rebuild")
    add_json(rb)
    rb.set_defaults(func=cmd_rebuild)

    fl = sub.add_parser("flush")
    add_json(fl)
    fl.set_defaults(func=cmd_flush)

    return p


def main() -> None:
    args = build_parser().parse_args()
    base, token = resolve_config()
    args.func(args, base, token)


if __name__ == "__main__":
    main()

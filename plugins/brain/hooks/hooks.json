{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/recall_inject.py\"",
            "timeout": 4
          }
        ],
        "description": "Gated recall: inject relevant long-term memory as additionalSystemPrompt"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/capture.py\"",
            "async": true,
            "timeout": 180
          }
        ],
        "description": "Distill the session into durable memory and brain-write candidates to inbox"
      }
    ]
  }
}
